{
  "name": "chaingraph",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source, client-side crypto forensics and OSINT workspace: multi-chain fund-flow graphs, mixer and obfuscation analysis, risk scoring, GEOINT and OSINT toolkit. No API keys required.",
  "license": "MIT",
  "author": "highstat",
  "homepage": "https://highstat.github.io/chaingraph/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/highstat/chaingraph.git"
  },
  "bugs": {
    "url": "https://github.com/highstat/chaingraph/issues"
  },
  "keywords": [
    "osint",
    "blockchain",
    "crypto",
    "forensics",
    "chain-analysis",
    "bitcoin",
    "ethereum",
    "tron",
    "solana",
    "tornado-cash",
    "geoint",
    "investigation",
    "obsidian"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "mcp:build": "vite build --config mcp/vite.config.ts",
    "mcp": "node mcp/dist/chaingraph-mcp.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "exifr": "^7.1.3",
    "force-graph": "^1.52.0",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^1.75.0",
    "mgrs": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suncalc": "^2.1.4",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "bin": {
    "chaingraph-mcp": "mcp/dist/chaingraph-mcp.mjs"
  }
}
